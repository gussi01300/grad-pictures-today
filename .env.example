# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/grad_pictures

# Redis
REDIS_URL=redis://localhost:6379

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=grad-pictures

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# OpenRouter
OPENROUTER_API_KEY=sk_or_xxxxx

# Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Grad-Pictures.today

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=0xxxxx
TURNSTILE_SECRET_KEY=0xxxxx

# Cleanup (in hours)
UPLOAD_EXPIRY_HOURS=24
GENERATION_EXPIRY_HOURS=168

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000